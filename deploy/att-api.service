# systemd unit for the API. Install: cp att-api.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now att-api
[Unit]
Description=ATT Academy API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=att
Group=att
WorkingDirectory=/opt/att/server
ExecStart=/usr/bin/node --env-file=/opt/att/server/.env index.js
Restart=on-failure
RestartSec=3
# Hardening: the service can't see other users' files or change the system, and can write nowhere but its own folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/att
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
