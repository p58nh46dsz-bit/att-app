{
  "name": "att-server",
  "private": true,
  "version": "0.1.0",
  "description": "АТТ Академия — API server (Node + PostgreSQL). Runs separately from the static site.",
  "main": "index.js",
  "scripts": {
    "migrate": "node --env-file=.env migrate.js",
    "seed:catalog": "node --env-file=.env seedCatalog.js",
    "seed:data": "node --env-file=.env seedData.js",
    "import:schedule": "node --env-file=.env importSchedule.js",
    "create-admin": "node --env-file=.env createAdmin.js",
    "subjects": "node --env-file=.env subjects.js",
    "start": "node --env-file=.env index.js",
    "import:teachers": "node --env-file=.env importTeacherSchedule.js",
    "news:update": "node --env-file=.env updateNews.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=22"
  }
}
