# Copy to server/.env (gitignored) and fill in. Never commit real values.

# ── Database ────────────────────────────────────────────────────────────────────
# Production:  postgres://att_app:PASSWORD@localhost:5432/att     (a dedicated user, see docs/DEPLOY.md)
# Local Postgres.app: postgres://localhost:5432/att
DATABASE_URL=postgres://localhost:5432/att

# ── Secrets: generate each on the server and keep ONLY there (and in your own safe backup of this file) ─
# At least 32 random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# 64 hex characters. Encrypts the passwords an administrator may look up (AES-256-GCM). Without it the stored
# passwords cannot be read, and if it leaks together with the database they can:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_KEY=

# ── Network ─────────────────────────────────────────────────────────────────────
PORT=3050
# Production: listen on the loopback address only, nginx forwards requests to it. Leave empty for local work.
HOST=
# Production behind nginx: 1. Local work: leave empty.
TRUST_PROXY=
# Where uploaded files are kept (coursework, ДПО, lesson materials). Production: /var/lib/att/files, a folder
# outside the code (created by the deploy steps and copied by backup.sh). Local work: leave empty (server/uploads).
FILES_DIR=
# Sites allowed to call the API from a browser, comma-separated. In production the site and the API share one
# domain (the API is under /api), so nothing is needed; for local work:
CORS_ORIGINS=http://localhost:3040
