# Copy to server/.env (gitignored) and fill in. Never commit real values.
# Local Postgres.app: database "att" on the default port, no password.
DATABASE_URL=postgres://localhost:5432/att
# At least 32 random characters, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Sites allowed to call this API from a browser, comma-separated.
CORS_ORIGINS=http://localhost:3040,https://p58nh46dsz-bit.github.io
PORT=3050
# 64 hex characters. Encrypts the passwords an administrator may look up (AES-256-GCM). Keep it ONLY here
# (and in your backup of this file): without it the stored passwords cannot be read. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_KEY=
